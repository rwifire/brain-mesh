{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brain-mesh mesh.yaml",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "brain_mesh": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "user": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
    },
    "mounts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "read",
              "contribute"
            ]
          }
        },
        "required": [
          "id",
          "mode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "brain_mesh",
    "user"
  ],
  "additionalProperties": false
}
