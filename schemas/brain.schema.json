{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brain-mesh brain.yaml",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "out_of_scope": {
          "type": "string"
        },
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requires": {
          "type": "string",
          "minLength": 1
        },
        "links_to": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "const": "shared"
        },
        "owner": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9][A-Za-z0-9-]*(?:\\/[A-Za-z0-9][A-Za-z0-9._-]*)?$"
        },
        "policies": {
          "type": "object",
          "properties": {
            "people": {
              "type": "string",
              "const": "accountability"
            }
          },
          "required": [
            "people"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "description",
        "schema",
        "id",
        "type",
        "owner",
        "policies"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "out_of_scope": {
          "type": "string"
        },
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requires": {
          "type": "string",
          "minLength": 1
        },
        "links_to": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "id": {
          "type": "string",
          "const": "personal"
        },
        "type": {
          "type": "string",
          "const": "personal"
        },
        "owner": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "policies": {
          "type": "object",
          "properties": {
            "people": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "people"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "description",
        "schema",
        "id",
        "type",
        "owner",
        "policies"
      ],
      "additionalProperties": false
    }
  ]
}
