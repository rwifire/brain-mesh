{
  "name": "brain-mesh",
  "version": "0.0.0",
  "description": "Personal and shared AI brains as markdown in git.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "brain-mesh": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "execa": "^10.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
